# Editor defaults, so a contributor's setup doesn't fight rustfmt.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
# Markdown gives meaning to trailing spaces (a hard line break).
trim_trailing_whitespace = false
